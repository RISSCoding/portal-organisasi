# ── Database ────────────────────────────────────────────────────────────────
# Runtime role (non-owner, subject to RLS)
DATABASE_URL=postgres://portal_app:app@localhost:5432/portal
# Migration owner (bypasses RLS, used only by `bun run db:migrate`)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/portal

# ── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:3001

# ── Session / cookies ───────────────────────────────────────────────────────
SESSION_COOKIE_NAME=portal_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# ── MFA ─────────────────────────────────────────────────────────────────────
MFA_TOTP_ISSUER=Portal Organisasi
# 32-byte base64, encrypts per-user TOTP secrets at rest
MFA_TOTP_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_-base64_32

# ── Mail ────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Portal Organisasi <no-reply@portal.local>"
# In dev: Mailpit UI at http://localhost:8025

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO for self-host) ────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=portal
S3_FORCE_PATH_STYLE=true

# ── Single-tenant mode ──────────────────────────────────────────────────────
SINGLE_TENANT_MODE=false
SEED_ORG_SLUG=

# ── Bootstrap seed (bun run db:seed) ────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@portal.local
SEED_ADMIN_PASSWORD=changeme-please
SEED_ADMIN_NAME="Instance Admin"

# ── Testcontainers (Fedora + rootless Podman) ───────────────────────────────
# If Testcontainers times out on rootless Podman because Ryuk cannot reach
# the Docker API, uncomment the line below (user opt-in, agent must not
# hardcode this):
# TESTCONTAINERS_RYUK_DISABLED=true
